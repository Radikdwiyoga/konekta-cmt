# SQLite Database
DATABASE_URL="file:./dev.db"

# ==============================================================================
# Google Drive API Configuration (/api/sync-drive)
# Pilih mode autentikasi: "service_account" atau "oauth2"
# ==============================================================================
GOOGLE_AUTH_MODE="service_account"
GOOGLE_DRIVE_FOLDER_ID=""

# --- Opsi 1: Service Account ---
# Bisa gunakan pasangan EMAIL + PRIVATE_KEY (newline ditulis sebagai \n)
# atau path ke file JSON key di GOOGLE_SERVICE_ACCOUNT_KEY_FILE
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=""

# --- Opsi 2: OAuth2 ---
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_OAUTH_REFRESH_TOKEN=""
